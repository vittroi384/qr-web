# Full(strict) 전환용 Caddyfile 예시 (예정, docs/배포-절차.md 2-C 참조). 전환 시점에 저장소 루트의
# Caddyfile을 이 내용으로 교체한다. 기존 사이트 블록의 지시어는 (site) 스니펫으로 옮기고, 평문
# 입구({$DOMAIN}, Cloudflare 모드에서는 ":80")와 Origin CA TLS 입구(:8443)가 같은 스니펫을 쓴다.
#
# compose 쪽에 함께 필요한 것 (docker-compose.port.yml 의 caddy 서비스):
#   ports:   - "8443:8443"            (8080:80 매핑은 전환 확인 후 제거)
#   volumes: - /etc/caddy/origin.pem:/etc/caddy/origin.pem:ro
#            - /etc/caddy/origin.key:/etc/caddy/origin.key:ro
{
	# Cloudflare 뒤에서는 docker-compose.cloudflare.yml 이 신뢰 프록시 스니펫을 여기에 마운트한다.
	import /etc/caddy/global.d/*.caddy
}

(site) {
	encode zstd gzip

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}

	header {
		defer
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	request_body {
		max_size 64KB
	}

	@umami_tracker path /umami/script.js /umami/api/send
	handle @umami_tracker {
		uri strip_prefix /umami
		reverse_proxy umami:3000
	}
	handle /umami/* {
		respond 404
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {client_ip}
	}
}

# 전환 기간의 평문 입구. Origin Rule 을 8443 으로 옮기고 확인한 뒤 이 블록과 8080 매핑을 제거한다.
{$DOMAIN} {
	import site
}

# Cloudflare 엣지 → 원본 TLS. 인증서는 Cloudflare Origin CA 가 발급한 것(공개 CA 아님, Cloudflare 만 신뢰).
:8443 {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	import site
}
