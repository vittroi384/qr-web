# Global options for running behind the Cloudflare proxy (mounted by docker-compose.cloudflare.yml).
# Only Cloudflare's edge ranges are trusted to report the real visitor IP, so {client_ip} in the
# Caddyfile is the visitor for proxied requests and the raw peer for anything that bypasses
# Cloudflare — a direct hit on the origin port cannot spoof the IP used by rate limits and logs.
# Ranges: https://www.cloudflare.com/ips/ (fetched 2026-10-04).
servers {
	client_ip_headers CF-Connecting-IP X-Forwarded-For
	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}
