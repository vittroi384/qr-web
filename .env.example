# Copy to .env and fill in. Never commit .env.

# Domain for automatic HTTPS (Caddy). Leave empty to serve plain HTTP on the server IP.
DOMAIN=qr.example.com

# Admin login password for /admin (choose a long one).
ADMIN_PASSWORD=change-me-to-a-long-password

# Secret used to sign admin session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# SQLite file path. Inside Docker this is fixed to /app/data/qr.db (mounted from ./data).
# For local `npm run dev` the default ./data/qr.db is used when unset.
# DATABASE_PATH=./data/qr.db
