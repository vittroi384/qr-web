# Copy to .env and fill in. Never commit .env.

# Domain for automatic HTTPS (Caddy). Also the default public site URL (https://<DOMAIN>) until one
# is saved in the admin settings. Leave empty to serve plain HTTP on the server IP — then do NOT log
# in to the admin area over the public address; use an SSH tunnel instead:
#   ssh -L 3000:127.0.0.1:3000 ubuntu@<server-ip>   →   http://localhost:3000/<ADMIN_PATH>
DOMAIN=qr.example.com
# Optional: public site URL when there is no DOMAIN (sitemap, canonical, OG). Default: http://localhost:3000
# SITE_URL=

# ---- Admin access (all three layers are REQUIRED in production) ----
# In production (NODE_ENV=production, i.e. the Docker image) the login API refuses every attempt
# until ADMIN_TOTP_SECRET is set and ADMIN_PASSWORD is at least 10 characters and not an example value.
# 1) Secret entry URL. /admin answers 404 unless you first visit https://<DOMAIN>/<ADMIN_PATH>,
#    which sets a 30-day gate cookie. Bookmark that URL. Generate: openssl rand -hex 8
ADMIN_PATH=/gate-change-me-0123abcd
# 2) Login password: at least 10 characters, unique. The example value below is rejected in production.
ADMIN_PASSWORD=change-me-to-a-long-password
# 3) One-time code (TOTP) secret — required before the first production login.
#    Generate + scan the QR with: npm run totp-setup   (in Docker: docker compose exec app node scripts/totp-setup.mjs)
ADMIN_TOTP_SECRET=
# Optional: only these IPs/CIDRs may reach the admin area at all (comma separated). Leave empty to allow any IP.
# ADMIN_ALLOWED_IPS=203.0.113.10, 198.51.100.0/24

# Secret used to sign admin session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# ---- Database (PostgreSQL 16) ----
# Password for the "qr" database user. docker compose creates the db with it and builds the app's
# DATABASE_URL (postgres://qr:<password>@db:5432/qr) itself, so keep it URL-safe.
# Generate: openssl rand -hex 24  (scripts/server-setup.sh fills it in). Leave empty locally:
# docker-compose.local.yml then uses "qrlocal".
POSTGRES_PASSWORD=
# Used by `npm run dev` / `npm run db:migrate` on your machine against docker-compose.local.yml.
# Inside Docker this is overridden to point at the db service.
DATABASE_URL=postgres://qr:qrlocal@localhost:5432/qr

# ---- Visitor analytics (Umami, self-hosted, cookieless) ----
# scripts/server-setup.sh and deploy.sh fill both in when missing. Both are required by docker-compose.yml.
# Secret Umami uses to sign its dashboard login tokens. Generate: openssl rand -hex 32
UMAMI_APP_SECRET=
# Password of Umami's own database role "umami" (not the superuser qr); keep it URL-safe.
# Generate: openssl rand -hex 24. deploy.sh re-applies it to the role on every deploy.
UMAMI_DB_PASSWORD=
# The dashboard is bound to the server's loopback (127.0.0.1:3001): open it through an SSH tunnel.
# Only the tracker is public, at https://<DOMAIN>/umami/script.js.

# Optional: Telegram alerts from scripts/backup.sh (bot token from @BotFather, chat id of your DM/group)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Server already using 80/443 for another project? Serve on another port instead (see docker-compose.port.yml).
# COMPOSE_FILE=docker-compose.yml:docker-compose.port.yml
# QR_HTTP_PORT=8080
# ...and once a domain exists, put the Cloudflare proxy in front of that port (TLS at Cloudflare,
# real visitor IPs trusted from Cloudflare's ranges). Keep DOMAIN set; see docker-compose.cloudflare.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.port.yml:docker-compose.cloudflare.yml
