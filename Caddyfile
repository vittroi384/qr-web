# DOMAIN comes from .env via docker-compose. With a real domain Caddy issues a
# Let's Encrypt certificate automatically; with ":80" it serves plain HTTP.
{$DOMAIN} {
	encode zstd gzip

	# JSON access log, rotated (5 × 10 MB). Read with: docker compose exec caddy cat /data/access.log
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Long cache for Next.js hashed assets.
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Cap request bodies at the edge; the log API only needs a few KB.
	request_body {
		max_size 64KB
	}

	# Umami tracker only: the script and its beacon endpoint (the tracker derives /umami/api/send
	# from its own src). Everything else under /umami, including the dashboard, is a 404 here;
	# the dashboard is reachable only on the server's loopback (SSH tunnel, see README).
	@umami_tracker path /umami/script.js /umami/api/send
	handle @umami_tracker {
		uri strip_prefix /umami
		reverse_proxy umami:3000
	}
	handle /umami/* {
		respond 404
	}

	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}
